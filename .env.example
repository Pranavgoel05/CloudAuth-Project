# Safe local defaults. Never put actual production secrets in source control.
APP_ENV=development
CLOUD_SIMULATION=true
AWS_DEFAULT_REGION=us-east-1
DATABASE_URL=sqlite:///./cloud_auth.db
# Leave blank for local-only generated files. For hosted deployments, set these in the host's secret settings.
AUTH_JWT_SECRET=
AUTH_ENCRYPTION_KEY=
# Optional one-time admin bootstrap. Local startup prompts in the terminal if no admin exists.
# On a hosted deployment, set these in the hosting dashboard's private environment-variable settings.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
